/// Реально выделенные назначения; перестановки сохраняются в общем аудите.
model FleetAllocation {
  requestId    Int
  assignmentId Int
  request      FleetRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  assignment   FleetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@id([requestId, assignmentId])
  @@map("fleet_allocation")
}

/// Подтверждённая ответственность; доступ отдельно от факта ДТП.
model FleetIncidentLiability {
  id              Int           @id @default(autoincrement())
  incidentId      Int           @unique
  employeeId      Int
  confirmedAmount Decimal       @db.Decimal(15, 2)
  recoveredAmount Decimal       @db.Decimal(15, 2)
  evidence        String        @db.Text
  note            String?       @db.Text
  version         Int           @default(1)
  updatedAt       DateTime      @updatedAt
  incident        FleetIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  employee        User          @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("fleet_incident_liability")
}

model FleetFuelType {
  code String @id @db.VarChar(80)

  @@map("fleet_fuel_type")
}

/// Только завершённые импорты. Предварительный просмотр не пишет в БД.
model FleetImportBatch {
  id                           Int               @id @default(autoincrement())
  directionId                  Int
  createdById                  Int
  fileName                     String            @db.VarChar(200)
  fileHash                     String            @db.Char(64)
  kind                         String            @db.VarChar(20)
  mapping                      Json
  importedRows                 Int
  skippedRows                  Int
  createdAt                    DateTime          @default(now())
  direction                    Direction         @relation(fields: [directionId], references: [id], onDelete: Restrict)
  createdBy                    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  fleetVehicleImportBatchId    FleetVehicle[]    @relation("FleetVehicleImportBatchId")
  fleetAssignmentImportBatchId FleetAssignment[] @relation("FleetAssignmentImportBatchId")
  fleetIncidentImportBatchId   FleetIncident[]   @relation("FleetIncidentImportBatchId")
  fleetFineImportBatchId       FleetFine[]       @relation("FleetFineImportBatchId")
  fleetTollImportBatchId       FleetToll[]       @relation("FleetTollImportBatchId")
  fleetFuelImportBatchId       FleetFuel[]       @relation("FleetFuelImportBatchId")
  fleetDowntimeImportBatchId   FleetDowntime[]   @relation("FleetDowntimeImportBatchId")
  fleetRequestImportBatchId    FleetRequest[]    @relation("FleetRequestImportBatchId")
  fleetSnapshotImportBatchId   FleetSnapshot[]   @relation("FleetSnapshotImportBatchId")

  @@index([directionId, createdAt])
  @@map("fleet_import_batch")
}
