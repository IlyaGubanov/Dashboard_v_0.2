# Скопируйте в .env и задайте свои значения. Файл .env не публикуйте — в нём пароли.

# --- Адрес и сертификат (контейнер caddy) ---
# Домен приложения. DNS-запись A этого домена должна указывать на внешний IP сервера.
DOMAIN=dashboard.example.ru
# auto     — бесплатный сертификат Let's Encrypt (нужны домен и порты 80, 443 открытые из интернета)
# files    — сертификат организации: положите cert.pem и key.pem в deploy/certs/
# internal — собственный сертификат Caddy (для проверки; браузер покажет предупреждение)
TLS_MODE=auto

# --- MySQL (контейнер db) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mvs
MYSQL_USER=mvs
MYSQL_PASSWORD=change-me

# --- API ---
# Только для запуска API без Docker (при разработке). В Docker адрес БД собирается из MYSQL_*.
DATABASE_URL=mysql://mvs:change-me@localhost:3306/mvs
# Срок жизни сессии входа, часов
SESSION_TTL_HOURS=12
# true — cookie входа только по HTTPS. В Docker включено; false — только для разработки по http://localhost
COOKIE_SECURE=true
# true — открыть документацию API на /api/docs (снаружи через HTTPS она всё равно закрыта)
API_DOCS=false

# Первый администратор, создаётся при первом запуске, если администраторов ещё нет
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMe!2026

# true — при старте загрузить демо-данные исходного дашборда в пустые направления.
# Заполненные направления не трогаются. Когда начнёте вносить реальные данные — поставьте false.
DEMO_DATA=true

# Подложка карты: откуда браузеру разрешено грузить картинки тайлов
MAP_TILES_HOST=https://tile.openstreetmap.org
